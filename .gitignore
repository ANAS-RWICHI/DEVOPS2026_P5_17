# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# Data and models are tracked by DVC, never by Git
/data/*
!/data/raw/
/data/raw/*
!/data/raw/*.dvc
!/data/raw/.gitignore
/models/
/metrics/promotion.json
/metrics/*.png

# Local MLflow store (used when no tracking server is configured)
/mlflow.db
/mlruns/
/mlartifacts/

# Secrets and local config
.env
